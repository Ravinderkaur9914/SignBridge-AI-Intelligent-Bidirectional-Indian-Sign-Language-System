# ============================
# SignBridge AI — .gitignore
# ============================

# API Keys — CRITICAL: NEVER commit
.env
.env.local
*.key

# Python cache
__pycache__/
*.py[cod]
*.pyc

# Virtual Environment
venv/
env/
.venv/

# Trained model files (large — share via Google Drive or Git LFS)
model/*.h5
model/*.pkl
model/*.keras
model/checkpoints/

# Dataset files (large)
data/dataset/
data/raw/
*.npy

# Streamlit cache
.streamlit/secrets.toml

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temp audio files (generated by TTS)
*.mp3
*.wav